# Managed by mailadmin install. Complain mode: logs what enforce would deny.
# Upstream has no rspamd profile, this one is written for this host.
#include <tunables/global>

/usr/bin/rspamd flags=(complain) {
  #include <abstractions/base>
  #include <abstractions/nameservice>
  #include <abstractions/ssl_certs>

  capability setgid,
  capability setuid,
  capability chown,
  capability dac_override,
  capability net_bind_service,

  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix stream,
  network unix dgram,

  /usr/bin/rspamd mr,
  /usr/bin/rspamadm mr,
  /usr/bin/rspamc mr,
  /usr/share/rspamd/** r,
  /usr/lib/rspamd/** mr,
  /etc/rspamd/ r,
  /etc/rspamd/** r,
  /var/lib/rspamd/ rw,
  /var/lib/rspamd/** rwk,
  /var/log/rspamd/ rw,
  /var/log/rspamd/** rw,
  /run/rspamd/ rw,
  /run/rspamd/** rwk,
  /etc/machine-id r,
  /proc/sys/kernel/random/uuid r,
  # Observed in complain mode: public suffix list and THP setting for the mail parser.
  /usr/share/publicsuffix/ r,
  /usr/share/publicsuffix/** r,
  /sys/kernel/mm/transparent_hugepage/enabled r,
  /proc/@{pid}/stat r,
  /proc/@{pid}/status r,
  /proc/sys/net/core/somaxconn r,
  /dev/urandom r,
  /dev/null rw,

  # Credentials and mailadmin state are not rspamd's business.
  deny /etc/mailadmin/** rw,
  deny /etc/ssl/private/** r,
  deny /root/** rwx,
  deny /home/** rwx,
  deny /var/vmail/** w,
}
